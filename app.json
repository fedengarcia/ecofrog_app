{
  "expo": {
    "name": "EcoFrog App",
    "slug": "ecofrog_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ecofrogLogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/ecofrogLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/ecofrogLogo.png",
          "imageWidth": 250,
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ecofrogLogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/ecofrogLogo.png"
    }
  }
}
